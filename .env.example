# ─────────────────────────────────────────────────────────────
# Supabase (web app — exposed to browser via NEXT_PUBLIC_ prefix)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin of the web app, used in invite links. Required in production:
# without it (or APP_URL) invitations are refused.
NEXT_PUBLIC_APP_URL=https://your-web-app.onrender.com

# Shared secret the web sends as x-internal-secret to the push-notifications edge
# function. Same value as the edge-function secret and the Vault job_internal_secret.
# Random, 32+ characters; server-only.
INTERNAL_JOB_SECRET=

# Calendar feed endpoint override; unset derives it from NEXT_PUBLIC_SUPABASE_URL.
ICS_FEED_BASE_URL=

# Server-side Google key with Places API (New) for the mobile venue search proxy;
# not referrer-restricted. Unset makes /api/m/v1/places/* answer 503.
GOOGLE_MAPS_SERVER_API_KEY=

# ─────────────────────────────────────────────────────────────
# Resend (email notifications — server-only)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key

# ─────────────────────────────────────────────────────────────
# Anthropic (Tier 7 AI features — server-only, never expose)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ─────────────────────────────────────────────────────────────
# Google Maps (web app — exposed to browser via NEXT_PUBLIC_ prefix)
# Enable: Maps JavaScript API + Places API in Google Cloud Console
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────
# Supabase (mobile app — exposed to bundle via EXPO_PUBLIC_ prefix)
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the deployed web app — the mobile sync engine calls
# POST {base}/api/games/:id/finalize to complete games ended offline.
EXPO_PUBLIC_API_BASE_URL=https://your-web-app.onrender.com

# ─────────────────────────────────────────────────────────────
# Edge Functions (set via: supabase secrets set KEY=value)
# ─────────────────────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# EXPO_ACCESS_TOKEN=your-expo-push-access-token
# INTERNAL_JOB_SECRET=   (same value as the web's; required by push-notifications,
#                         practice-notifications-dispatch and pitch-count-calculator)
#
# Tier 5 — Integration Hub
# ICS_FEED_SECRET signs per-team calendar-subscription URLs. Treat this as a
# permanent project-level secret: rotating it invalidates every team's
# subscribed ICS URL simultaneously. Use a random value ≥ 32 characters.
# ICS_FEED_SECRET=
#
# League Home Page
# CRON_SECRET authorizes the scheduled league-snapshot rebuild route
# (/api/cron/rebuild-league-snapshots). The database scheduler sends it as a
# Bearer token (Vault job_cron_secret holds the same value).
# Use a random value ≥ 32 characters; server-only, never expose to the client.
# CRON_SECRET=
